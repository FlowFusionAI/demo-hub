      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nstaticData.rateLimits = staticData.rateLimits ?? {};\nconst rateLimits = staticData.rateLimits;\n\nconst now = Date.now();\nconst WINDOW_MS = 60 * 1000;  // 1min\nconst MAX_REQUESTS = 10;\n\nconst headers = $input.first().json.headers;\nconst ip = headers['x-forwarded-for']?.split(',')[0].trim()\n  || headers['x-real-ip']\n  || 'unknown';\n\n// Prune stale entries for ALL IPs on every execution\nfor (const key of Object.keys(rateLimits)) {\n  rateLimits[key] = rateLimits[key].filter(t => now - t < WINDOW_MS);\n  if (rateLimits[key].length === 0) {\n    delete rateLimits[key];\n  }\n}\n\n// Check and update current IP\nconst hits = rateLimits[ip] || [];\n\nif (hits.length >= MAX_REQUESTS) {\n  const retryAfter = Math.ceil((hits[0] + WINDOW_MS - now) / 1000);\n  return [{ json: { rateLimited: true, retryAfter, ip } }];\n}\n\nhits.push(now);\nrateLimits[ip] = hits;\n\nreturn [{ json: { ...($input.first().json), rateLimited: false } }];\n"
      },
