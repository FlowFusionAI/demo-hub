    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = Date.now();\n\nconst rank = { critical: 0, high: 1 };\nconst tickets = items\n  .map(i => i.json)\n  .sort((a, b) => {\n    const u = (rank[a.Urgency] ?? 9) - (rank[b.Urgency] ?? 9);\n    return u !== 0 ? u : new Date(a.Created).getTime() - new Date(b.Created).getTime();\n  });\n\nfunction age(created) {\n  const mins = Math.floor((now - new Date(created).getTime()) / 60000);\n  if (mins < 60) return `${mins}m`;\n  const h = Math.floor(mins / 60), m = mins % 60;\n  if (h < 24) return m ? `${h}h ${m}m` : `${h}h`;\n  const d = Math.floor(h / 24), rh = h % 24;\n  return rh ? `${d}d ${rh}h` : `${d}d`;\n}\n\nconst emoji = { critical: '🔴', high: '🟠' };\nconst crit = tickets.filter(t => t.Urgency === 'critical').length;\nconst high = tickets.filter(t => t.Urgency === 'high').length;\n\n// one compact line per ticket\nconst lines = tickets.map(t =>\n  `${emoji[t.Urgency] || '⚪'} *#${t.TicketID} ${t.Subject}*  ·  ${t.Category}  ·  open ${age(t.Created)}  ·  <mailto:${t.Email}|${t.Name}>`\n);\n\n// split into chunks so no section exceeds Slack's 3000-char limit\nconst chunks = [];\nlet buf = '';\nfor (const line of lines) {\n  if ((buf + '\\n' + line).length > 2900) { chunks.push(buf); buf = line; }\n  else { buf = buf ? buf + '\\n' + line : line; }\n}\nif (buf) chunks.push(buf);\n\nconst blocks = [\n  {\n    type: 'header',\n    text: { type: 'plain_text', text: `🚨 ${tickets.length} urgent ticket${tickets.length === 1 ? '' : 's'} open > 1h`, emoji: true },\n  },\n  {\n    type: 'context',\n    elements: [{ type: 'mrkdwn', text: `${crit} critical · ${high} high · as of <!date^${Math.floor(now / 1000)}^{time}|now>` }],\n  },\n  { type: 'divider' },\n  ...chunks.map(text => ({ type: 'section', text: { type: 'mrkdwn', text } })),\n];\n\nreturn [{ json: { blocks, text: `${tickets.length} urgent tickets open over 1h` } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
